{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["powershell"],
  "ignoreDependencies": ["@types/bcryptjs", "pino-pretty"],
  "workspaces": {
    ".": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignore": ["dist/**", "database/**", "declarations.d.ts"]
    },
    "frontend": {
      "project": ["src/**/*.{ts,tsx}", "*.{js,ts}"],
      "ignore": ["dist/**"]
    }
  }
}
