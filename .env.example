# PostgreSQL connection string (Supabase pooler)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Supabase project URL
SUPABASE_URL=https://<project-ref>.supabase.co/

# Supabase service role key (for Storage access)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secrets (min 16 characters)
JWT_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# JWT expiration (optional, defaults shown)
JWT_EXP_MIN=30
JWT_REFRESH_EXP_DAYS=7

# CORS allowed origins (comma-separated, empty = reflective)
CORS_ORIGINS=http://localhost:5173

# Server port (optional, default 4000)
PORT=4000

# Log level (optional, default info)
LOG_LEVEL=info

# Environment (optional, default development)
NODE_ENV=development

# Show error details in 500 responses (optional, default false in production)
EXPOSE_ERROR_DETAILS=true

# Database query timeout in ms (optional, default 15000)
DB_STATEMENT_TIMEOUT_MS=15000
